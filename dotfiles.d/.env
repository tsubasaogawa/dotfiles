LC_ALL=ja_JP.UTF-8
LANG=ja_JP.UTF-8

GOPATH="$HOME/go"
NVM_DIR="$HOME/.nvm"
PNPM_HOME="$HOME/.local/share/pnpm"

TF_CLI_ARGS_plan="--parallelism=20"
TF_CLI_ARGS_apply="--parallelism=20"
TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin_cache"

AWS_REGION='ap-northeast-1'

COLORTERM=truecolor
LIBGL_ALWAYS_INDIRECT=1
